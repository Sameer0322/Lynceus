# Local dev — copy to .env.local and fill in values
VITE_API_BASE=http://localhost:8080

# Optional: filter the dashboard to one workflow by name
# Leave blank to show all workflows
VITE_WORKFLOW_NAME=

# Optional: URL for an external stage-flow / pipeline-status tool
# If set, a button appears in the header linking to this URL
VITE_STAGE_FLOW_URL=
